            <trans-unit id="attribute.valueType.number" approved="yes"><source>Number</source><target>Arv</target></trans-unit>
            <trans-unit id="attribute.valueType.text" approved="yes"><source>Text</source><target>Tekst</target></trans-unit>
            <trans-unit id="attribute.valueType.percent" approved="yes"><source>Percent</source><target>Protsent</target></trans-unit>
            <trans-unit id="attribute.unit" approved="yes"><source>Unit</source><target>Ühik</target></trans-unit>
            <trans-unit id="attribute.unit.hint" approved="yes"><source>Shown after the value, e.g. “GB” or “users”.</source><target>Kuvatakse väärtuse järel, nt „GB“ või „kasutajad“.</target></trans-unit>
