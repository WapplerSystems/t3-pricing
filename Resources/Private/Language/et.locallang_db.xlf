            <trans-unit id="value.attribute" approved="yes"><source>Feature</source><target>Funktsioon</target></trans-unit>
            <trans-unit id="value.included" approved="yes"><source>Included</source><target>Sisaldub</target></trans-unit>
            <trans-unit id="value.included.hint" approved="yes"><source>Applies to features of the type “Check or dash”.</source><target>Kehtib funktsioonidele tüübiga „Linnuke või kriips“.</target></trans-unit>
            <trans-unit id="value.value" approved="yes"><source>Value</source><target>Väärtus</target></trans-unit>
            <trans-unit id="value.value.hint" approved="yes"><source>For number, text and percent. E.g. “unlimited”, “up to 48” or “2.1”.</source><target>Arvu, teksti ja protsendi jaoks. Nt „piiramatu“, „kuni 48“ või „2.1“.</target></trans-unit>
            <trans-unit id="flexform.sheet" approved="yes"><source>Pricing table</source><target>Hinnatabel</target></trans-unit>
            <trans-unit id="flexform.table" approved="yes"><source>Pricing table</source><target>Hinnatabel</target></trans-unit>
