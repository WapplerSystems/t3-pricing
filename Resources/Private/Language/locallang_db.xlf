<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="messages" date="2026-10-19T10:00:00Z" product-name="pricing">
        <header/>
        <body>
            <trans-unit id="tx_pricing_domain_model_table"><source>Pricing table</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_plan"><source>Plan</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_price"><source>Price</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_group"><source>Feature group</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_attribute"><source>Feature</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_value"><source>Value</source></trans-unit>
            <trans-unit id="plugin.table"><source>Pricing table</source></trans-unit>
            <trans-unit id="plugin.table.description"><source>Plan cards, comparison table or compact rows from one pricing table record.</source></trans-unit>
            <trans-unit id="tab.general"><source>General</source></trans-unit>
            <trans-unit id="tab.plans"><source>Plans</source></trans-unit>
            <trans-unit id="tab.attributes"><source>Features</source></trans-unit>
            <trans-unit id="tab.prices"><source>Prices</source></trans-unit>
            <trans-unit id="tab.highlight"><source>Highlight</source></trans-unit>
            <trans-unit id="table.title"><source>Title</source></trans-unit>
            <trans-unit id="table.description"><source>Introductory note</source></trans-unit>
            <trans-unit id="table.description.hint"><source>Shown above the prices in every layout, e.g. “All prices per month, plus VAT.”</source></trans-unit>
            <trans-unit id="table.taxMode"><source>Entered amounts are</source></trans-unit>
            <trans-unit id="table.taxMode.hint"><source>Defines how the entered amounts are read. Conversion only runs from net to gross, never the other way round.</source></trans-unit>
            <trans-unit id="table.taxMode.net"><source>Net prices</source></trans-unit>
            <trans-unit id="table.taxMode.gross"><source>Gross prices</source></trans-unit>
            <trans-unit id="table.taxRate"><source>Tax rate in percent</source></trans-unit>
            <trans-unit id="table.taxRate.hint"><source>Basis for the gross display. 0 skips the conversion.</source></trans-unit>
            <trans-unit id="table.taxSwitchable"><source>Visitors may switch between net and gross</source></trans-unit>
            <trans-unit id="table.taxSwitchable.hint"><source>Unchecked, the page only shows the option selected above.</source></trans-unit>
            <trans-unit id="table.currencySwitchable"><source>Currency switchable</source></trans-unit>
            <trans-unit id="table.currencySwitchable.hint"><source>The switch only appears if more than one currency is entered for the plans.</source></trans-unit>
            <trans-unit id="table.periodSwitchable"><source>Billing period switchable</source></trans-unit>
            <trans-unit id="table.periodSwitchable.hint"><source>The switch only appears if more than one period is entered for the plans.</source></trans-unit>
            <trans-unit id="table.currencyPosition"><source>Currency symbol</source></trans-unit>
            <trans-unit id="table.currencyPosition.hint"><source>English usually puts it before the amount (“€ 99”), German and most continental European languages after it (“99 €”).</source></trans-unit>
            <trans-unit id="table.currencyPosition.before"><source>before the amount (€ 99)</source></trans-unit>
            <trans-unit id="table.currencyPosition.after"><source>after the amount (99 €)</source></trans-unit>
            <trans-unit id="table.selectLabel"><source>Button label</source></trans-unit>
            <trans-unit id="table.selectLabel.hint"><source>Applies to all plans without a label of their own. Empty means “Select”.</source></trans-unit>
            <trans-unit id="table.selectLabel.placeholder"><source>Select</source></trans-unit>
            <trans-unit id="table.plans"><source>Plans</source></trans-unit>
            <trans-unit id="table.groups"><source>Feature groups</source></trans-unit>
            <trans-unit id="table.groups.hint"><source>Features belong to the table, not to a single plan — that is the only way the comparison table compares like with like.</source></trans-unit>
            <trans-unit id="plan.title"><source>Name</source></trans-unit>
            <trans-unit id="plan.subtitle"><source>Subtitle</source></trans-unit>
            <trans-unit id="plan.subtitle.hint"><source>One line below the name, e.g. “6 job ads for 30 days each”.</source></trans-unit>
            <trans-unit id="plan.eyebrow"><source>Eyebrow</source></trans-unit>
            <trans-unit id="plan.eyebrow.hint"><source>Small line above the name, e.g. “48 resources included”.</source></trans-unit>
            <trans-unit id="plan.description"><source>Description</source></trans-unit>
            <trans-unit id="plan.favourite"><source>Highlight</source></trans-unit>
            <trans-unit id="plan.favourite.hint"><source>The plan gets a border and shadow in the accent colour, and a tinted column in the comparison table.</source></trans-unit>
            <trans-unit id="plan.badge"><source>Badge text</source></trans-unit>
            <trans-unit id="plan.badge.hint"><source>Empty omits the badge. Common are “Popular” or “Recommended”.</source></trans-unit>
            <trans-unit id="plan.badge.placeholder"><source>Popular</source></trans-unit>
            <trans-unit id="plan.selectLink"><source>Select button target</source></trans-unit>
            <trans-unit id="plan.selectLink.hint"><source>Without a link no button is rendered — neither an empty one nor a placeholder.</source></trans-unit>
            <trans-unit id="plan.selectLabel"><source>Own label</source></trans-unit>
            <trans-unit id="plan.selectLabel.hint"><source>Overrides the label from the pricing table, for this plan only.</source></trans-unit>
            <trans-unit id="plan.priceNote"><source>Note below the price</source></trans-unit>
            <trans-unit id="plan.priceNote.hint"><source>E.g. “billed annually” or “excl. VAT”.</source></trans-unit>
            <trans-unit id="plan.prices"><source>Prices</source></trans-unit>
            <trans-unit id="plan.attributeValues"><source>Feature values</source></trans-unit>
            <trans-unit id="plan.attributeValues.hint"><source>Features without a value count as not included and show a dash. Not every cell has to be filled.</source></trans-unit>
            <trans-unit id="price.currency"><source>Currency</source></trans-unit>
            <trans-unit id="price.period"><source>Period</source></trans-unit>
            <trans-unit id="price.period.month"><source>per month</source></trans-unit>
            <trans-unit id="price.period.year"><source>per year</source></trans-unit>
            <trans-unit id="price.period.once"><source>one-time</source></trans-unit>
            <trans-unit id="price.period.custom"><source>custom</source></trans-unit>
            <trans-unit id="price.unitLabel"><source>Own unit</source></trans-unit>
            <trans-unit id="price.unitLabel.hint"><source>E.g. “per ad” or “per calendar”.</source></trans-unit>
            <trans-unit id="price.amount"><source>Amount</source></trans-unit>
            <trans-unit id="price.onRequest"><source>Price on request</source></trans-unit>
            <trans-unit id="price.onRequestLabel"><source>Text instead of the amount</source></trans-unit>
            <trans-unit id="price.onRequestLabel.hint"><source>Empty means “Price on request”.</source></trans-unit>
            <trans-unit id="group.title"><source>Title</source></trans-unit>
            <trans-unit id="group.layout"><source>Layout</source></trans-unit>
            <trans-unit id="group.layout.hint"><source>A checklist for yes/no features, value pairs for details such as fees or quotas.</source></trans-unit>
            <trans-unit id="group.layout.list"><source>Checklist</source></trans-unit>
            <trans-unit id="group.layout.pairs"><source>Value pairs</source></trans-unit>
            <trans-unit id="group.inCard"><source>Show on cards</source></trans-unit>
            <trans-unit id="group.inCard.hint"><source>Some groups belong in the comparison table only and would overload the card.</source></trans-unit>
            <trans-unit id="group.inMatrix"><source>Show in comparison table</source></trans-unit>
            <trans-unit id="group.inMatrix.hint"><source>Unchecked, the group is left out of the comparison table.</source></trans-unit>
            <trans-unit id="group.attributes"><source>Features</source></trans-unit>
            <trans-unit id="attribute.title"><source>Title</source></trans-unit>
            <trans-unit id="attribute.valueType"><source>Value type</source></trans-unit>
            <trans-unit id="attribute.valueType.hint"><source>Determines how the cell looks in the comparison table.</source></trans-unit>
            <trans-unit id="attribute.valueType.check"><source>Check or dash</source></trans-unit>
            <trans-unit id="attribute.valueType.number"><source>Number</source></trans-unit>
            <trans-unit id="attribute.valueType.text"><source>Text</source></trans-unit>
            <trans-unit id="attribute.valueType.percent"><source>Percent</source></trans-unit>
            <trans-unit id="attribute.unit"><source>Unit</source></trans-unit>
            <trans-unit id="attribute.unit.hint"><source>Shown after the value, e.g. “GB” or “users”.</source></trans-unit>
            <trans-unit id="attribute.footnote"><source>Footnote</source></trans-unit>
            <trans-unit id="attribute.footnote.hint"><source>Shown in small print after the title in the comparison table.</source></trans-unit>
            <trans-unit id="value.attribute"><source>Feature</source></trans-unit>
            <trans-unit id="value.included"><source>Included</source></trans-unit>
            <trans-unit id="value.included.hint"><source>Applies to features of the type “Check or dash”.</source></trans-unit>
            <trans-unit id="value.value"><source>Value</source></trans-unit>
            <trans-unit id="value.value.hint"><source>For number, text and percent. E.g. “unlimited”, “up to 48” or “2.1”.</source></trans-unit>
            <trans-unit id="flexform.sheet"><source>Pricing table</source></trans-unit>
            <trans-unit id="flexform.table"><source>Pricing table</source></trans-unit>
            <trans-unit id="flexform.table.hint"><source>The record holding plans and features. The same table can appear on several pages in different layouts.</source></trans-unit>
            <trans-unit id="flexform.layout"><source>Layout</source></trans-unit>
            <trans-unit id="flexform.layout.hint"><source>Plan cards for a few plans, compact rows from about five, the comparison table for many features.</source></trans-unit>
            <trans-unit id="flexform.layout.cards"><source>Plan cards</source></trans-unit>
            <trans-unit id="flexform.layout.matrix"><source>Comparison table</source></trans-unit>
            <trans-unit id="flexform.layout.groups"><source>Cards with feature groups</source></trans-unit>
            <trans-unit id="flexform.layout.rows"><source>Compact rows</source></trans-unit>
            <trans-unit id="flexform.layout.accordion"><source>Cards with expandable details</source></trans-unit>
            <trans-unit id="flexform.showMatrix"><source>Also show comparison table</source></trans-unit>
            <trans-unit id="flexform.showMatrix.hint"><source>The comparison table then appears below the chosen layout.</source></trans-unit>
            <trans-unit id="flexform.collapseMatrix"><source>Comparison table collapsed</source></trans-unit>
            <trans-unit id="flexform.collapseMatrix.hint"><source>The comparison table only opens on click — keeps the page calm with many features.</source></trans-unit>
        </body>
    </file>
