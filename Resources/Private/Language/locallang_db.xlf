    <file source-language="de" datatype="plaintext" original="messages" date="2026-09-21T10:00:00Z" product-name="pricing">
        <header/>
        <body>
            <trans-unit id="tx_pricing_domain_model_table"><source>Preistabelle</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_plan"><source>Tarif</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_price"><source>Preis</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_group"><source>Attributgruppe</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_attribute"><source>Attribut</source></trans-unit>
            <trans-unit id="tx_pricing_domain_model_value"><source>Wert</source></trans-unit>
            <trans-unit id="plugin.table"><source>Preistabelle</source></trans-unit>
            <trans-unit id="tab.general"><source>Allgemein</source></trans-unit>
            <trans-unit id="tab.plans"><source>Tarife</source></trans-unit>
            <trans-unit id="tab.attributes"><source>Merkmale</source></trans-unit>
            <trans-unit id="tab.prices"><source>Preise</source></trans-unit>
            <trans-unit id="tab.highlight"><source>Hervorhebung</source></trans-unit>
            <trans-unit id="table.title"><source>Bezeichnung</source></trans-unit>
            <trans-unit id="table.description"><source>Hinweis unter der Überschrift</source></trans-unit>
            <trans-unit id="table.description.hint"><source>Erscheint in der Matrix über der ersten Spalte, etwa „Alle Preise je Monat, zuzüglich Umsatzsteuer.“</source></trans-unit>
            <trans-unit id="table.taxMode"><source>Gepflegte Beträge sind</source></trans-unit>
            <trans-unit id="table.taxMode.hint"><source>Entscheidet, wie die eingetragenen Beträge zu lesen sind. Umgerechnet wird nur von netto nach brutto, nie umgekehrt.</source></trans-unit>
            <trans-unit id="table.taxMode.net"><source>Nettopreise</source></trans-unit>
            <trans-unit id="table.taxMode.gross"><source>Bruttopreise</source></trans-unit>
            <trans-unit id="table.taxRate"><source>Steuersatz in Prozent</source></trans-unit>
            <trans-unit id="table.taxRate.hint"><source>Grundlage für die Bruttoanzeige. 0 lässt die Umrechnung aus.</source></trans-unit>
            <trans-unit id="table.taxSwitchable"><source>Besucher dürfen zwischen netto und brutto umschalten</source></trans-unit>
            <trans-unit id="table.taxSwitchable.hint"><source>Ohne Haken zeigt die Seite nur die oben gewählte Angabe.</source></trans-unit>
            <trans-unit id="table.currencySwitchable"><source>Währung umschaltbar</source></trans-unit>
            <trans-unit id="table.currencySwitchable.hint"><source>Der Schalter erscheint nur, wenn zu den Tarifen mehr als eine Währung gepflegt ist.</source></trans-unit>
            <trans-unit id="table.periodSwitchable"><source>Abrechnungszeitraum umschaltbar</source></trans-unit>
            <trans-unit id="table.periodSwitchable.hint"><source>Der Schalter erscheint nur, wenn zu den Tarifen mehr als ein Zeitraum gepflegt ist.</source></trans-unit>
            <trans-unit id="table.selectLabel"><source>Beschriftung der Knöpfe</source></trans-unit>
            <trans-unit id="table.selectLabel.hint"><source>Gilt für alle Tarife, die keine eigene Beschriftung tragen. Leer bedeutet „Auswählen“.</source></trans-unit>
            <trans-unit id="table.plans"><source>Tarife</source></trans-unit>
            <trans-unit id="table.groups"><source>Merkmalsgruppen</source></trans-unit>
            <trans-unit id="table.groups.hint"><source>Die Merkmale gehören der Tabelle, nicht dem einzelnen Tarif — nur so vergleicht die Matrix Gleiches mit Gleichem.</source></trans-unit>
            <trans-unit id="plan.title"><source>Name</source></trans-unit>
            <trans-unit id="plan.subtitle"><source>Untertitel</source></trans-unit>
            <trans-unit id="plan.subtitle.hint"><source>Eine Zeile unter dem Namen, etwa „6 Stelleninserate à 30 Tage“.</source></trans-unit>
            <trans-unit id="plan.eyebrow"><source>Kicker</source></trans-unit>
            <trans-unit id="plan.eyebrow.hint"><source>Kleine Zeile über dem Namen, etwa „48 Ressourcen inklusive“.</source></trans-unit>
            <trans-unit id="plan.description"><source>Beschreibung</source></trans-unit>
            <trans-unit id="plan.favourite"><source>Hervorheben</source></trans-unit>
            <trans-unit id="plan.favourite.hint"><source>Der Tarif bekommt Rahmen und Schatten in der Akzentfarbe und in der Matrix eine eingefärbte Spalte.</source></trans-unit>
            <trans-unit id="plan.badge"><source>Plakettentext</source></trans-unit>
            <trans-unit id="plan.badge.hint"><source>Leer lässt die Plakette weg. Üblich sind „Beliebt“ oder „Empfehlung“.</source></trans-unit>
            <trans-unit id="plan.selectLink"><source>Ziel des Auswählen-Knopfes</source></trans-unit>
            <trans-unit id="plan.selectLink.hint"><source>Ohne Link wird kein Knopf ausgegeben — weder ein leerer noch ein Platzhalter.</source></trans-unit>
            <trans-unit id="plan.selectLabel"><source>Eigene Beschriftung</source></trans-unit>
            <trans-unit id="plan.selectLabel.hint"><source>Überschreibt die Beschriftung aus der Preistabelle, nur für diesen Tarif.</source></trans-unit>
            <trans-unit id="plan.priceNote"><source>Fußnote unter dem Preis</source></trans-unit>
            <trans-unit id="plan.priceNote.hint"><source>Etwa „bei jährlicher Zahlung“ oder „exkl. MWST“.</source></trans-unit>
            <trans-unit id="plan.prices"><source>Preise</source></trans-unit>
            <trans-unit id="plan.attributeValues"><source>Merkmalswerte</source></trans-unit>
            <trans-unit id="plan.attributeValues.hint"><source>Nicht gepflegte Merkmale gelten als nicht enthalten und zeigen einen Strich. Es muss also nicht jede Zelle gefüllt werden.</source></trans-unit>
            <trans-unit id="price.currency"><source>Währung</source></trans-unit>
            <trans-unit id="price.period"><source>Zeitraum</source></trans-unit>
            <trans-unit id="price.period.month"><source>je Monat</source></trans-unit>
            <trans-unit id="price.period.year"><source>je Jahr</source></trans-unit>
            <trans-unit id="price.period.once"><source>einmalig</source></trans-unit>
            <trans-unit id="price.period.custom"><source>eigene Angabe</source></trans-unit>
            <trans-unit id="price.unitLabel"><source>Eigene Einheit</source></trans-unit>
            <trans-unit id="price.unitLabel.hint"><source>Etwa „je Inserat“ oder „je Kalender“.</source></trans-unit>
            <trans-unit id="price.amount"><source>Betrag</source></trans-unit>
            <trans-unit id="price.onRequest"><source>Preis auf Anfrage</source></trans-unit>
            <trans-unit id="price.onRequestLabel"><source>Text statt des Betrages</source></trans-unit>
            <trans-unit id="price.onRequestLabel.hint"><source>Leer bedeutet „Preis auf Anfrage“.</source></trans-unit>
            <trans-unit id="group.title"><source>Bezeichnung</source></trans-unit>
            <trans-unit id="group.layout"><source>Darstellung</source></trans-unit>
            <trans-unit id="group.layout.hint"><source>Eine Liste mit Haken für Ja-Nein-Merkmale, Wertepaare für Angaben wie Gebühren oder Kontingente.</source></trans-unit>
            <trans-unit id="group.layout.list"><source>Liste mit Haken</source></trans-unit>
            <trans-unit id="group.layout.pairs"><source>Wertepaare</source></trans-unit>
            <trans-unit id="group.inCard"><source>Auf den Karten zeigen</source></trans-unit>
            <trans-unit id="group.inCard.hint"><source>Manche Gruppen gehören nur in die Matrix und würden die Karte überladen.</source></trans-unit>
            <trans-unit id="group.inMatrix"><source>In der Vergleichsmatrix zeigen</source></trans-unit>
            <trans-unit id="group.inMatrix.hint"><source>Ohne Haken bleibt die Gruppe aus der Matrix heraus.</source></trans-unit>
            <trans-unit id="group.attributes"><source>Merkmale</source></trans-unit>
            <trans-unit id="attribute.title"><source>Bezeichnung</source></trans-unit>
            <trans-unit id="attribute.valueType"><source>Art des Wertes</source></trans-unit>
            <trans-unit id="attribute.valueType.hint"><source>Bestimmt, wie die Zelle in der Matrix aussieht.</source></trans-unit>
            <trans-unit id="attribute.valueType.check"><source>Haken oder Strich</source></trans-unit>
            <trans-unit id="attribute.valueType.number"><source>Zahl</source></trans-unit>
            <trans-unit id="attribute.valueType.text"><source>Text</source></trans-unit>
            <trans-unit id="attribute.valueType.percent"><source>Prozent</source></trans-unit>
            <trans-unit id="attribute.unit"><source>Einheit</source></trans-unit>
            <trans-unit id="attribute.unit.hint"><source>Steht hinter dem Wert, etwa „GB“ oder „Nutzer“.</source></trans-unit>
            <trans-unit id="attribute.footnote"><source>Fußnote</source></trans-unit>
            <trans-unit id="attribute.footnote.hint"><source>Erscheint klein hinter der Bezeichnung in der Matrix.</source></trans-unit>
            <trans-unit id="value.attribute"><source>Merkmal</source></trans-unit>
            <trans-unit id="value.included"><source>Enthalten</source></trans-unit>
            <trans-unit id="value.included.hint"><source>Gilt für Merkmale der Art „Haken oder Strich“.</source></trans-unit>
            <trans-unit id="value.value"><source>Wert</source></trans-unit>
            <trans-unit id="value.value.hint"><source>Für Zahl, Text und Prozent. Etwa „unbegrenzt“, „bis 48“ oder „2,1“.</source></trans-unit>
            <trans-unit id="flexform.sheet"><source>Preistabelle</source></trans-unit>
            <trans-unit id="flexform.table"><source>Preistabelle</source></trans-unit>
            <trans-unit id="flexform.table.hint"><source>Der Datensatz mit Tarifen und Merkmalen. Dieselbe Tabelle kann auf mehreren Seiten in verschiedenen Darstellungen stehen.</source></trans-unit>
            <trans-unit id="flexform.layout"><source>Darstellung</source></trans-unit>
            <trans-unit id="flexform.layout.hint"><source>Tarifkarten für wenige Tarife, Kompaktzeilen ab etwa fünf, die Matrix für viele Merkmale.</source></trans-unit>
            <trans-unit id="flexform.layout.cards"><source>Tarifkarten</source></trans-unit>
            <trans-unit id="flexform.layout.matrix"><source>Vergleichsmatrix</source></trans-unit>
            <trans-unit id="flexform.layout.groups"><source>Karten mit Merkmalsgruppen</source></trans-unit>
            <trans-unit id="flexform.layout.rows"><source>Kompaktzeilen</source></trans-unit>
            <trans-unit id="flexform.layout.accordion"><source>Karten mit Aufklappern</source></trans-unit>
            <trans-unit id="flexform.showMatrix"><source>Vergleichsmatrix zusätzlich zeigen</source></trans-unit>
            <trans-unit id="flexform.showMatrix.hint"><source>Die Matrix steht dann unter der gewählten Darstellung.</source></trans-unit>
            <trans-unit id="flexform.collapseMatrix"><source>Matrix eingeklappt</source></trans-unit>
            <trans-unit id="flexform.collapseMatrix.hint"><source>Die Matrix öffnet sich erst auf Klick — schont die Seite bei vielen Merkmalen.</source></trans-unit>
        </body>
