            <trans-unit id="table.currencyPosition.before" approved="yes"><source>before the amount (€ 99)</source><target>ennen summaa (€ 99)</target></trans-unit>
            <trans-unit id="table.currencyPosition.after" approved="yes"><source>after the amount (99 €)</source><target>summan jälkeen (99 €)</target></trans-unit>
