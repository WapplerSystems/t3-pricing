            <trans-unit id="plan.badge.placeholder" approved="yes"><source>Popular</source><target>Suosittu</target></trans-unit>
            <trans-unit id="plan.selectLink" approved="yes"><source>Select button target</source><target>Valitse-painikkeen kohde</target></trans-unit>
