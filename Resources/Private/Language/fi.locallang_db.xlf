            <trans-unit id="plan.selectLabel" approved="yes"><source>Own label</source><target>Oma teksti</target></trans-unit>
            <trans-unit id="plan.selectLabel.hint" approved="yes"><source>Overrides the label from the pricing table, for this plan only.</source><target>Korvaa hinnoittelutaulukon tekstin vain tälle suunnitelmalle.</target></trans-unit>
            <trans-unit id="plan.priceNote" approved="yes"><source>Note below the price</source><target>Huomautus hinnan alla</target></trans-unit>
            <trans-unit id="plan.priceNote.hint" approved="yes"><source>E.g. “billed annually” or “excl. VAT”.</source><target>Esim. ”laskutetaan vuosittain” tai ”ilman ALV”.</target></trans-unit>
