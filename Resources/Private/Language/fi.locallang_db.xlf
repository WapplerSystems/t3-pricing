            <trans-unit id="group.layout.list" approved="yes"><source>Checklist</source><target>Tarkistuslista</target></trans-unit>
            <trans-unit id="group.layout.pairs" approved="yes"><source>Value pairs</source><target>Arvoparit</target></trans-unit>
