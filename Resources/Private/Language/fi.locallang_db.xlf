            <trans-unit id="attribute.valueType.text" approved="yes"><source>Text</source><target>Teksti</target></trans-unit>
            <trans-unit id="attribute.valueType.percent" approved="yes"><source>Percent</source><target>Prosentti</target></trans-unit>
            <trans-unit id="attribute.unit" approved="yes"><source>Unit</source><target>Yksikkö</target></trans-unit>
            <trans-unit id="attribute.unit.hint" approved="yes"><source>Shown after the value, e.g. “GB” or “users”.</source><target>Näytetään arvon jälkeen, esim. ”GB” tai ”käyttäjät”.</target></trans-unit>
            <trans-unit id="attribute.footnote" approved="yes"><source>Footnote</source><target>Alaviite</target></trans-unit>
            <trans-unit id="attribute.footnote.hint" approved="yes"><source>Shown in small print after the title in the comparison table.</source><target>Näytetään pienellä tekstillä otsikon jälkeen vertailutaulukossa.</target></trans-unit>
            <trans-unit id="value.attribute" approved="yes"><source>Feature</source><target>Ominaisuus</target></trans-unit>
            <trans-unit id="value.included" approved="yes"><source>Included</source><target>Sisältyy</target></trans-unit>
            <trans-unit id="value.included.hint" approved="yes"><source>Applies to features of the type “Check or dash”.</source><target>Koskee ominaisuuksia, joiden tyyppi on ”Rasti tai viiva”.</target></trans-unit>
            <trans-unit id="value.value" approved="yes"><source>Value</source><target>Arvo</target></trans-unit>
            <trans-unit id="value.value.hint" approved="yes"><source>For number, text and percent. E.g. “unlimited”, “up to 48” or “2.1”.</source><target>Numeroille, tekstille ja prosentille. Esim. ”rajoittamaton”, ”jopa 48” tai ”2.1”.</target></trans-unit>
            <trans-unit id="flexform.sheet" approved="yes"><source>Pricing table</source><target>Hinnoittelutaulukko</target></trans-unit>
