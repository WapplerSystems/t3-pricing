            <trans-unit id="plugin.table" approved="yes"><source>Pricing table</source><target>Verðtafla</target></trans-unit>
            <trans-unit id="plugin.table.description" approved="yes"><source>Plan cards, comparison table or compact rows from one pricing table record.</source><target>Pakkaspjöld, samanburðartafla eða þjappaðar raðir úr einni verðtöflu.</target></trans-unit>
            <trans-unit id="tab.general" approved="yes"><source>General</source><target>Almennt</target></trans-unit>
            <trans-unit id="tab.plans" approved="yes"><source>Plans</source><target>Pakkar</target></trans-unit>
