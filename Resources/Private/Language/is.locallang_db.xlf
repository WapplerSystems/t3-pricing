            <trans-unit id="price.onRequestLabel.hint" approved="yes"><source>Empty means “Price on request”.</source><target>Tómt þýðir „Verð að beiðni“.</target></trans-unit>
            <trans-unit id="group.title" approved="yes"><source>Title</source><target>Heiti</target></trans-unit>
            <trans-unit id="group.layout" approved="yes"><source>Layout</source><target>Útlit</target></trans-unit>
            <trans-unit id="group.layout.hint" approved="yes"><source>A checklist for yes/no features, value pairs for details such as fees or quotas.</source><target>Gátlisti fyrir já/nei eiginleika, gildapör fyrir upplýsingar eins og gjöld eða kvóta.</target></trans-unit>
            <trans-unit id="group.layout.list" approved="yes"><source>Checklist</source><target>Gátlisti</target></trans-unit>
            <trans-unit id="group.layout.pairs" approved="yes"><source>Value pairs</source><target>Gildapör</target></trans-unit>
            <trans-unit id="group.inCard" approved="yes"><source>Show on cards</source><target>Sýna á spjöldum</target></trans-unit>
            <trans-unit id="group.inCard.hint" approved="yes"><source>Some groups belong in the comparison table only and would overload the card.</source><target>Sumir hópar eiga aðeins heima í samanburðartöflunni og myndu ofhlaða spjaldið.</target></trans-unit>
            <trans-unit id="group.inMatrix" approved="yes"><source>Show in comparison table</source><target>Sýna í samanburðartöflu</target></trans-unit>
            <trans-unit id="group.inMatrix.hint" approved="yes"><source>Unchecked, the group is left out of the comparison table.</source><target>Ef ekki er hakað við er hópnum sleppt úr samanburðartöflunni.</target></trans-unit>
            <trans-unit id="group.attributes" approved="yes"><source>Features</source><target>Eiginleikar</target></trans-unit>
            <trans-unit id="attribute.title" approved="yes"><source>Title</source><target>Heiti</target></trans-unit>
            <trans-unit id="attribute.valueType" approved="yes"><source>Value type</source><target>Gildistegund</target></trans-unit>
            <trans-unit id="attribute.valueType.hint" approved="yes"><source>Determines how the cell looks in the comparison table.</source><target>Ákvarðar hvernig reiturinn lítur út í samanburðartöflunni.</target></trans-unit>
            <trans-unit id="attribute.valueType.check" approved="yes"><source>Check or dash</source><target>Hak eða bandstrik</target></trans-unit>
            <trans-unit id="attribute.valueType.number" approved="yes"><source>Number</source><target>Tala</target></trans-unit>
            <trans-unit id="attribute.valueType.text" approved="yes"><source>Text</source><target>Texti</target></trans-unit>
            <trans-unit id="attribute.valueType.percent" approved="yes"><source>Percent</source><target>Prósent</target></trans-unit>
            <trans-unit id="attribute.unit" approved="yes"><source>Unit</source><target>Eining</target></trans-unit>
            <trans-unit id="attribute.unit.hint" approved="yes"><source>Shown after the value, e.g. “GB” or “users”.</source><target>Sýnt á eftir gildinu, t.d. „GB“ eða „notendur“.</target></trans-unit>
            <trans-unit id="attribute.footnote" approved="yes"><source>Footnote</source><target>Neðanmálsgrein</target></trans-unit>
            <trans-unit id="attribute.footnote.hint" approved="yes"><source>Shown in small print after the title in the comparison table.</source><target>Sýnt í smáu letri á eftir titlinum í samanburðartöflunni.</target></trans-unit>
            <trans-unit id="value.attribute" approved="yes"><source>Feature</source><target>Eiginleiki</target></trans-unit>
            <trans-unit id="value.included" approved="yes"><source>Included</source><target>Innifalið</target></trans-unit>
            <trans-unit id="value.included.hint" approved="yes"><source>Applies to features of the type “Check or dash”.</source><target>Á við eiginleika af gerðinni „Hak eða bandstrik“.</target></trans-unit>
            <trans-unit id="value.value" approved="yes"><source>Value</source><target>Gildi</target></trans-unit>
            <trans-unit id="value.value.hint" approved="yes"><source>For number, text and percent. E.g. “unlimited”, “up to 48” or “2.1”.</source><target>Fyrir tölu, texta og prósentur. T.d. „ótakmarkað“, „allt að 48“ eða „2.1“.</target></trans-unit>
            <trans-unit id="flexform.sheet" approved="yes"><source>Pricing table</source><target>Verðtafla</target></trans-unit>
            <trans-unit id="flexform.table" approved="yes"><source>Pricing table</source><target>Verðtafla</target></trans-unit>
            <trans-unit id="flexform.table.hint" approved="yes"><source>The record holding plans and features. The same table can appear on several pages in different layouts.</source><target>Færslan sem heldur utan um pakka og eiginleika. Sama tafla getur birst á nokkrum síðum með mismunandi útliti.</target></trans-unit>
            <trans-unit id="flexform.layout" approved="yes"><source>Layout</source><target>Útlit</target></trans-unit>
            <trans-unit id="flexform.layout.hint" approved="yes"><source>Plan cards for a few plans, compact rows from about five, the comparison table for many features.</source><target>Pakkaspjöld fyrir fáa pakka, þjappaðar raðir frá um fimm pökkum, samanburðartafla fyrir marga eiginleika.</target></trans-unit>
            <trans-unit id="flexform.layout.cards" approved="yes"><source>Plan cards</source><target>Pakkaspjöld</target></trans-unit>
            <trans-unit id="flexform.layout.matrix" approved="yes"><source>Comparison table</source><target>Samanburðartafla</target></trans-unit>
            <trans-unit id="flexform.layout.groups" approved="yes"><source>Cards with feature groups</source><target>Spjöld með eiginleikahópum</target></trans-unit>
            <trans-unit id="flexform.layout.rows" approved="yes"><source>Compact rows</source><target>Þjappaðar raðir</target></trans-unit>
            <trans-unit id="flexform.layout.accordion" approved="yes"><source>Cards with expandable details</source><target>Spjöld með útfellanlegum upplýsingum</target></trans-unit>
            <trans-unit id="flexform.showMatrix" approved="yes"><source>Also show comparison table</source><target>Sýna einnig samanburðartöflu</target></trans-unit>
            <trans-unit id="flexform.showMatrix.hint" approved="yes"><source>The comparison table then appears below the chosen layout.</source><target>Samanburðartaflan birtist þá fyrir neðan valið útlit.</target></trans-unit>
            <trans-unit id="flexform.collapseMatrix" approved="yes"><source>Comparison table collapsed</source><target>Samanburðartafla samanbrotin</target></trans-unit>
            <trans-unit id="flexform.collapseMatrix.hint" approved="yes"><source>The comparison table only opens on click — keeps the page calm with many features.</source><target>Samanburðartaflan opnast aðeins við smell — heldur síðunni rólegri þegar margir eiginleikar eru til staðar.</target></trans-unit>
