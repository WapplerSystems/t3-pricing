            <trans-unit id="price.unitLabel.hint" approved="yes"><source>E.g. “per ad” or “per calendar”.</source><target>T.d. „á auglýsingu“ eða „á dagatal“.</target></trans-unit>
            <trans-unit id="price.amount" approved="yes"><source>Amount</source><target>Upphæð</target></trans-unit>
            <trans-unit id="price.onRequest" approved="yes"><source>Price on request</source><target>Verð að beiðni</target></trans-unit>
