            <trans-unit id="flexform.layout.rows" approved="yes"><source>Compact rows</source><target>Kompakt satırlar</target></trans-unit>
            <trans-unit id="flexform.layout.accordion" approved="yes"><source>Cards with expandable details</source><target>Genişletilebilir ayrıntılara sahip kartlar</target></trans-unit>
