            <trans-unit id="table.taxMode" approved="yes"><source>Entered amounts are</source><target>Girilen tutarlar</target></trans-unit>
            <trans-unit id="table.taxMode.hint" approved="yes"><source>Defines how the entered amounts are read. Conversion only runs from net to gross, never the other way round.</source><target>Girilen tutarların nasıl yorumlanacağını tanımlar. Dönüştürme yalnızca netten brüte yapılır, asla tersi yönde değil.</target></trans-unit>
            <trans-unit id="table.taxMode.net" approved="yes"><source>Net prices</source><target>Net fiyatlar</target></trans-unit>
            <trans-unit id="table.taxMode.gross" approved="yes"><source>Gross prices</source><target>Brüt fiyatlar</target></trans-unit>
            <trans-unit id="table.taxRate" approved="yes"><source>Tax rate in percent</source><target>Vergi oranı (%)</target></trans-unit>
            <trans-unit id="table.taxRate.hint" approved="yes"><source>Basis for the gross display. 0 skips the conversion.</source><target>Brüt gösterimin temelidir. 0 dönüştürmeyi atlar.</target></trans-unit>
            <trans-unit id="table.taxSwitchable" approved="yes"><source>Visitors may switch between net and gross</source><target>Ziyaretçiler net ve brüt arasında geçiş yapabilir</target></trans-unit>
            <trans-unit id="table.taxSwitchable.hint" approved="yes"><source>Unchecked, the page only shows the option selected above.</source><target>İşaretlenmezse sayfa yalnızca yukarıda seçilen seçeneği gösterir.</target></trans-unit>
            <trans-unit id="table.currencySwitchable" approved="yes"><source>Currency switchable</source><target>Para birimi değiştirilebilir</target></trans-unit>
