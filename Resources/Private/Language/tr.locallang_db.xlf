            <trans-unit id="flexform.layout.cards" approved="yes"><source>Plan cards</source><target>Plan kartları</target></trans-unit>
            <trans-unit id="flexform.layout.matrix" approved="yes"><source>Comparison table</source><target>Karşılaştırma tablosu</target></trans-unit>
